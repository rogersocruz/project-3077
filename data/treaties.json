  "templates": [
    {
      "id": "tpl_preferential_tariff",
      "name": "Contrato de Tarifa Preferencial",
      "type": "contract",
      "if": {
        "subject": "anySignatory",
        "verb": "enter",
        "object": "territory",
        "of": "otherSignatory"
      },
      "then": {
        "obligor": "actor",
        "verb": "overrideToll",
        "object": "resource",
        "type": "iron",
        "amount": 1,
        "perTroop": true
      },
      "text": "SE um participante entrar no TERRITÓRIO do outro, ENTÃO o invasor paga apenas 1 de FERRO por tropa (em vez da tarifa declarada).",
      "art": {
        "subject": "two holographic diplomats shaking hands in front of a glowing territory map"
      }
    },
    {
      "id": "tpl_mutual_insurance",
      "name": "Seguro Mútuo",
      "type": "contract",
      "if": {
        "subject": "third",
        "verb": "attack",
        "object": "village",
        "of": "eitherSignatory"
      },
      "then": {
        "obligor": "otherSignatory",
        "verb": "pay",
        "object": "resource",
        "type": "iron",
        "amount": 3
      },
      "text": "SE um terceiro ATACAR a Vila de um de nós, ENTÃO o outro signatário paga 3 de FERRO à vítima."
    },
    {
      "id": "tpl_non_aggression",
      "name": "Pacto de Não Agressão",
      "type": "pact",
